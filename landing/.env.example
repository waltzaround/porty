# Public, HTTPS-only artifact URLs. Blank entries show "Coming soon".
# Vite embeds these values into the public page; never put secrets here.
VITE_DOWNLOAD_WINDOWS=
VITE_DOWNLOAD_MAC_ARM64=
VITE_DOWNLOAD_MAC_X64=
VITE_RELEASE_VERSION=1.0.3
# Label previews that do not have publisher signing.
VITE_WINDOWS_UNSIGNED=false
VITE_MAC_UNSIGNED=false
# Public HTTPS origin, for example your own domain without a subpath.
# Leave blank for local previews; public builds require the real domain.
SITE_URL=
# Indexing is enabled when SITE_URL is set. Use false on hosted previews.
SITE_INDEXABLE=
